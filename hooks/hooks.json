{
  "description": "strata guards: layer modes and closed tracks, judged from .strata/strata.toml. Inert in projects without a manifest.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hooks/run.sh\" layer-guard",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
